{
  "name": "rangoli-fashions",
  "version": "1.0.0",
  "private": true,
  "description": "Rangoli Fashions - Production-Ready Full-Stack Ethnic E-Commerce Platform",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:api": "npm run start:dev --workspace=@rangoli/api",
    "dev:storefront": "npm run dev --workspace=@rangoli/storefront",
    "dev:admin": "npm run dev --workspace=@rangoli/admin",
    "build:packages": "npm run build --workspaces --if-present",
    "build:api": "npm run build --workspace=@rangoli/api",
    "build:storefront": "npm run build --workspace=@rangoli/storefront",
    "build:admin": "npm run build --workspace=@rangoli/admin",
    "build": "npm run build --workspaces --if-present",
    "prisma:generate": "npm run prisma:generate --workspace=@rangoli/api",
    "prisma:migrate": "npm run prisma:migrate --workspace=@rangoli/api",
    "prisma:seed": "npm run prisma:seed --workspace=@rangoli/api",
    "test": "npm run test --workspaces --if-present"
  },
  "devDependencies": {
    "typescript": "^5.7.3"
  }
}
